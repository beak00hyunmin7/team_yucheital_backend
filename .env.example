# Docker Compose local-development passwords. Change both values before any
# shared or externally reachable deployment.
MYSQL_PASSWORD=terrain
MYSQL_ROOT_PASSWORD=terrain-root-local

# AI 모델 선택: "unet"(기본값, AI 모델링 팀의 학습된 U-Net 사용) 또는 "d8"(예전
# D8 대리 모델만 사용). unet인데 체크포인트/torch가 없으면 자동으로 d8로 폴백합니다.
# AI_BACKEND=unet

# deploy_package/checkpoints/best.pt 경로. 기본값은 이 프로젝트와 같은 폴더(예:
# Desktop) 아래에 deploy_package가 나란히 있다고 가정합니다. 다른 위치에 있다면
# 이 값을 실제 경로로 바꿔서 주석을 해제하세요.
# AI_MODEL_CHECKPOINT=C:\Users\User\Desktop\deploy_package\checkpoints\best.pt
